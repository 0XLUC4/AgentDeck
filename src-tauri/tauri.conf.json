{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AgentDeck",
  "version": "0.1.0",
  "identifier": "com.agentdeck.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "AgentDeck",
        "width": 1400,
        "height": 900,
        "minWidth": 800,
        "minHeight": 500,
        "decorations": false,
        "resizable": true,
        "shadow": true
      },
      {
        "label": "voice",
        "title": "AgentDeck Voice",
        "url": "voice.html",
        "width": 320,
        "height": 72,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "resizable": false,
        "visible": false,
        "shadow": false,
        "focus": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost",
      "devCsp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "publisher": "Luca",
    "copyright": "© 2026 Luca",
    "category": "DeveloperTool",
    "shortDescription": "Tableau de bord multi-agents pour terminaux IA",
    "longDescription": "AgentDeck lance et supervise plusieurs agents de code (Claude Code, Codex, Gemini CLI, shells) côte à côte, avec statuts, notifications et dictée vocale.",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["French", "English"],
        "displayLanguageSelector": true,
        "startMenuFolder": "AgentDeck"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQxRUJBQjlCQTcwRjAxRjAKUldUd0FRK25tNnZyMGVQN0ppbDhaZCt4TG5SVGwvZHMyWUdRVmZOdnQ3bWZtUnBRMHFPdGNKMjgK",
      "endpoints": ["https://agentdeck-updates.pages.dev/latest.json"],
      "windows": { "installMode": "passive" }
    }
  }
}
